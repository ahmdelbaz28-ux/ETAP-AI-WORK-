tors\n# ==========================================\n.vscode/\n.idea/\n*.swp\n*.swo\n*~\n.project\n.classpath\n.settings/\n*.sublime-workspace\n*.sublime-project\n\n# ==========================================\n# OS Files\n# ==========================================\n.DS_Store\n.DS_Store?\n._*\n.Spotlight-V100\n.Trashes\nehthumbs.db\nThumbs.db\nDesktop.ini\n\n# Windows\n$RECYCLE.BIN/\nSystem Volume Information/\n# Stale git worktree artifacts (left over from interrupted operations)\n/worktree-*/\n\n# Windows reserved device names that can never be created as files on Windows\n# (git for Windows refuses to add them)\n/nul\n/con\n/prn\n/aux\n/com1\n/com2\n/com3\n/com4\n/com5\n/com6\n/com7\n/com8\n/com9\n/lpt1\n/lpt2\n/lpt3\n/lpt4\n/lpt5\n/lpt6\n/lpt7\n/lpt8\n/lpt9\n\n# Linux\n.fuse_hidden*\n.directory\n.Trash-*\n\n# ==========================================\n# Environment & Secrets\n# ==========================================\n.env\n.env.local\n.env.*.local\n!.env.example\n\n# Secrets\n*.pem\n*.key\n*.cert\nsecrets/\ncredentials/\n\n# API Keys (never commit)\napi_keys.json\nservice-account.json\n*.secret\njwt_key.txt\n\n# ==========================================\n# Logs\n# ==========================================\nlogs/\n*.log\n\n# ==========================================\n# Database & Data\n# ==========================================\n*.db\n*.db-shm\n*.db-wal\n*.duckdb\n*.sqlite\n*.sqlite3\n*.sqlite-shm\n*.sqlite-wal\ndata/\nknowledge_db/\nchroma_db/\nfaiss_index/\n\n# ==========================================\n# Reports & Generated Files\n# ==========================================\nreports/\nexports/\noutput/\nresults/\npower_system_report.txt\nhealth-check-report.json\nsecurity_audit.log\ncoordination_margin.png\n# Generated PNGs at project root (charts/plots)\n/*.png\n# Generated TXT reports at project root\n/*.report.txt\n\n# ==========================================\n# Temporary Files\n# ==========================================\ntmp/\ntemp/\n*.tmp