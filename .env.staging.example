# =============================================================================
# AhmedETAP — Staging Local Orchestration Environment Variables Template
# =============================================================================
# Copy this file to .env.staging (which is git-ignored) and supply values:
#   cp .env.staging.example .env.staging
#
# Run the Staging stack:
#   docker compose --env-file .env.staging -f docker-compose.staging.yml up -d
# =============================================================================

# Dedicated Staging PostgreSQL Connection String (Supabase project guunodspzhcxpmdwwyjv)
# Format: postgresql+asyncpg://postgres.guunodspzhcxpmdwwyjv:<password>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres?ssl=require
STAGING_DATABASE_URL=

# Staging Security Keys (Must match GitHub Environment Secrets for staging)
STAGING_JWT_SECRET_KEY=
STAGING_ENGINEERING_SERVICE_API_KEY=

# Cloudflare Verification / Testing token (optional)
CF_TOKEN_TEST=

# Ingress Mode:
# 1. Domainless Cloudflare Free Mode (Default):
#    Does NOT require CLOUDFLARE_TUNNEL_TOKEN or any domain. Runs `cloudflared-quick`
#    and binds ephemeral Quick Tunnel upstream origin to the dedicated Staging Worker:
#    https://ahmedetap-staging-proxy.ahmedetap.workers.dev
#
# 2. Named Tunnel Mode (Optional, requires custom DNS zone):
#    Set CLOUDFLARE_TUNNEL_TOKEN and run with `--profile named-tunnel`:
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: Deployment commit SHA override (defaults to git rev-parse HEAD / build SHA)
# DEPLOY_SHA=your-40-char-commit-sha-here

# Staging E2E Capabilities & Capability Probe Variables
STAGING_API_KEY=
STAGING_WORKER_URL=https://ahmedetap-staging-proxy.ahmedetap.workers.dev
STAGING_TEST_EMAIL=
STAGING_TEST_PASSWORD=
STAGING_USER_TOKEN=
STAGING_LLM_KEY=
STAGING_LLM_PROVIDER=openai

