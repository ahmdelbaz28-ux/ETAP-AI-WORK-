# =============================================================================
ENGINEERING_SERVICE_VERSION=2.1.0
ENGINEERING_SERVICE_REQUEST_TIMEOUT=60
ENGINEERING_SERVICE_MAX_BODY_SIZE=10485760
ENGINEERING_SERVICE_CACHE_DISABLED=false
ENGINEERING_SERVICE_RATE_LIMIT_DISABLED=false
ENGINEERING_SERVICE_RATE_LIMIT_MAX=120
ENGINEERING_SERVICE_RATE_LIMIT_WINDOW=60
