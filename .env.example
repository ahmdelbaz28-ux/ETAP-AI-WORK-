# =============================================================================
CUA_AUDIT_DIR=./data/cua_audit
CUA_CHECKPOINT_DIR=./data/cua_checkpoints
CUA_LOOP_TIMEOUT_SEC=120
ETAP_GUI_QUICK_MODE=false
ETAP_DATA_DIR=./data
ETAP_PROMPTS_DIR=./prompts
