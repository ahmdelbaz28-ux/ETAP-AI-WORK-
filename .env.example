# =============================================================================
SLACK_WEBHOOK_URL=
ALERT_DEBOUNCE_SECONDS=60
NOTION_ENABLED=false
NOTION_API_KEY=
NOTION_PAT=
NOTION_DATABASE_ID=
NOTION_PARENT_PAGE_ID=
