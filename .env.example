SCADA_OPC_PASSWORD=

# MQTT Broker Telemetry
MQTT_BROKER=localhost
MQTT_USERNAME=
MQTT_PASSWORD=

# Telemetry Anomaly Detection Bounds
ANOMALY_VOLTAGE_MIN=0.9
ANOMALY_VOLTAGE_MAX=1.1
ANOMALY_CURRENT_MAX=1000.0
ANOMALY_TEMP_MAX=90.0

# =============================================================================
# ⚡ ETAP INTEGRATION, WORKER SERVICE & RUNTIME PROVIDERS
# =============================================================================
ETAP_WORKER_HOST=localhost
ETAP_WORKER_SERVICE_URL=http://localhost:8081
ETAP_PROVIDER=native
USE_MOCK_ETAP=false
ETAP_DEV_BASE_URL=
ETAP_DEV_API_KEY=
ETAP_DEV_PASSWORD=

# =============================================================================
# 🗺️ GIS & GEOSPATIAL INTEGRATION (ArcGIS, QGIS, PostGIS)
# =============================================================================
GIS_PROVIDER=mock
USE_MOCK_GIS=true
ARCGIS_USERNAME=
ARCGIS_PASSWORD=
ARCGIS_PRO_PROJECT_TEMPLATE=
QGIS_PREFIX_PATH=/usr
POSTGIS_DSN=postgresql://etap:password@localhost:5432/gis_db
POSTGIS_SCHEMA=public
ALLOW_GIS_TO_ETAP_SYNC=false
ALLOW_BIDIRECTIONAL_SYNC=false

# =============================================================================
# 🛡️ ENTERPRISE SECURITY, ABAC, RASP, SIEM & TOKENS
# =============================================================================
ABAC_ENABLED=true
ABAC_ENFORCE_BUSINESS_HOURS=false
AUTH_DISABLED=false
RASP_ENABLED=true
AUDIT_LOG_REDACT_SECRETS=true
ETAP_SECRETS_DIR=./secrets
SIEM_TYPE=syslog
SIEM_ENDPOINT=
SIEM_API_KEY=
ADMIN_TOKEN=
AUTH_TOKEN=
CSRF_TOKEN=
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin

# Secure Sandbox Execution Settings (Testing/Development only)
# In production, canonical calculation engines are strictly disallowed from run_python sandbox.
ETAP_ALLOW_SANDBOX_CANONICAL_ENGINES=false

# =============================================================================
# 📦 ASYNC CELERY WORKER SCALING & SECURITY
# =============================================================================
CELERY_MIN_WORKERS=2
CELERY_MAX_WORKERS=8
CELERY_BROKER_USE_SSL=false

# =============================================================================
# 🧠 KNOWLEDGE STORE, RAG & TIME SERIES
# =============================================================================
MODEL2VEC_MODEL_NAME=minishlab/potion-base-8M
RAG_ALLOW_HASH_FALLBACK=true
DUCKDBSTORE_DB_PATH=./data/duckdb.store
DUCKDBSTORE_IMPORT_PATH=
DUCKDBSTORE_CONSTRUCTOR_KWARGS_JSON={}
TIMESCALE_URL=
ETAP_INDEXER_DIR=./data/indexer
ZAI_API_KEY=

# =============================================================================
# 📊 REPORTING, OBSERVABILITY & WEB APPLICATION FIREWALL
# =============================================================================
REPORTS_OUTPUT_DIR=./reports
LANGFUSE_HOST=https://cloud.langfuse.com
LANGWATCH_PROJECT_ID=
LANGWATCH_DEFAULT_MODEL=gpt-4o

# Akamai Client Authentication & Edge Routing
AKAMAI_HOST=
AKAMAI_CLIENT_TOKEN=
AKAMAI_CLIENT_SECRET=
AKAMAI_ACCESS_TOKEN=
AKAMAI_EDGE_HOSTNAME=
AKAMAI_ORIGIN_HOSTNAME=
AKAMAI_REQUIRE_ORIGIN_TOKEN=false

# Cloudflare Account & Authentication
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_KEY=

# Application & API Base URLs
BACKEND_URL=http://localhost:8000
BASE_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000
GITHUB_PAT=
HUGGINGFACE_TOKEN=

# =============================================================================
# ⚠️ SECURITY NOTICE
# =============================================================================
# NEVER commit real secrets to Git. The .env file is gitignored.
# Rotate keys immediately if any leak occurs.
# =============================================================================
# END OF .env.example
# =============================================================================
