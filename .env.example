MCP_HEALTH_ALLOW_HTTP=false

# =============================================================================
# 📊 LANGFUSE & OBSERVABILITY EXTENDED CONTROLS
# =============================================================================
LANGFUSE_ENABLED=true
LANGFUSE_PROJECT_ID=
LANGFUSE_OVERRIDE_MODE=remote_first
LANGFUSE_SAFETY_PATHS=/api/v1/studies,/api/v1/agents
