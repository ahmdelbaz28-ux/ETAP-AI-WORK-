# =============================================================================
# AhmedETAP — Complete Canonical Environment Configuration
# =============================================================================
# نسخ هذا الملف إلى .env وأدخل قيمك الحقيقية
# Copy this file to .env and fill in your real values
# ⚠️ NEVER commit .env to version control
# =============================================================================

# =============================================================================
# 🌐 CORE ENVIRONMENT — بيئة التشغيل الأساسية
# =============================================================================
ENVIRONMENT=development        # development | staging | production
PORT=8000
HOST=0.0.0.0
APP_ENV=development

# =============================================================================
# 🔐 SECURITY & AUTHENTICATION — الأمان والمصادقة
# =============================================================================
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-jwt-secret-key-minimum-32-characters

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_ENCRYPTION_KEY=your-fernet-key-here
ENCRYPTION_KEY=your-encryption-key-here

# Required for session middleware (docker-compose.yml & web sessions)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=your-strong-session-secret-here

# =============================================================================
# 🗄️ DATABASE — قاعدة البيانات
# =============================================================================
# Local development SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./data/etap_platform.db

# Production PostgreSQL (canonical for production & docker-compose):
DATABASE_URL=postgresql+asyncpg://etap:your-strong-postgres-password-here@localhost:5432/etap_platform

# PostgreSQL credentials (REQUIRED for docker-compose)
POSTGRES_DB=etap_platform
POSTGRES_USER=etap
POSTGRES_PASSWORD=your-strong-postgres-password-here

# Legacy / Deploy Compose compatibility aliases
DB_NAME=etap_platform
DB_USER=etap
DB_PASSWORD=your-strong-postgres-password-here

# LibSQL (Mastra runtime storage)
MASTRA_DB_URL=file:./mastra.db

# =============================================================================
# ⚡ REDIS CACHE — التخزين المؤقت
# =============================================================================
REDIS_URL=redis://:your-strong-redis-password-here@localhost:6379/0

# For docker-compose: Redis password (REQUIRED by compose :?)
REDIS_PASSWORD=your-strong-redis-password-here

# =============================================================================
# 🔌 ENGINEERING SERVICE — خدمة الحسابات الهندسية (FastAPI)
# =============================================================================
ENGINEERING_SERVICE_URL=http://localhost:8000
ENGINEERING_SERVICE_PORT=8000
ENGINEERING_SERVICE_HOST=0.0.0.0
ENGINEERING_SERVICE_API_KEY=your-service-api-key-here

# CORS Configuration (comma-separated, no spaces)
# ENGINEERING_SERVICE_CORS_ORIGINS is the primary env var; CORS_ALLOWED_ORIGINS is supported for compose
ENGINEERING_SERVICE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Set to 'true' ONLY in local development tests to bypass API key check (strictly blocked in production)
# ENGINEERING_SERVICE_AUTH_DISABLED=false

# Trusted proxy IPs for X-Forwarded-For header validation
ENGINEERING_SERVICE_TRUSTED_PROXIES=127.0.0.1

# =============================================================================
# 🧠 VECTOR & GRAPH DATABASES — قواعد بيانات المتجهات والرسوم البيانية
# =============================================================================
# Qdrant Vector DB (RAG & Semantic Search)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=your-strong-qdrant-api-key-here

# Neo4j Graph DB (Network Topology)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-strong-neo4j-password-here

# =============================================================================
# 📡 OBSERVABILITY & MONITORING — المراقبة والقياسات
# =============================================================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Grafana Admin Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your-strong-grafana-admin-password-here
# Legacy aliases
GRAFANA_USER=admin
GRAFANA_PASSWORD=your-strong-grafana-admin-password-here

# =============================================================================
# 📊 LANGFUSE — إدارة ومراقبة النماذج اللغوية (Langfuse LLM Observability)
# =============================================================================
# Dashboard: https://cloud.langfuse.com/
LANGFUSE_PUBLIC_KEY=pk-lf-YOUR_LANGFUSE_PUBLIC_KEY_HERE
LANGFUSE_SECRET_KEY=sk-lf-YOUR_LANGFUSE_SECRET_KEY_HERE
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_DEFAULT_MODEL=gpt-4o

# Safety-critical LLM guardrails
LLM_MAX_INPUT_CHARS=50000
LLM_ALLOW_UNKNOWN_MODELS=false
LLM_REQUIRE_AGENT_TAG=true
LLM_APPROVED_MODELS=gpt-4o,gpt-4o-mini,gpt-4-turbo,gpt-4.1,gpt-4.1-mini,claude-3-5-sonnet-20241022,claude-3-5-haiku-20241022,claude-3-opus-20240229,gemini-2.0-flash-exp,gemini-1.5-pro,meta/llama-3.1-8b-instruct,abacusai/dracarys-llama-3.1-70b-instruct,accounts/fireworks/models/kimi-k2p7-code,zai-org/GLM-5.1-FP8,mimo-v2.5,@cf/moonshotai/kimi-k2.6,minimaxai/minimax-m3,@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Optional webhook for safety alerts
LANGFUSE_ALERT_WEBHOOK_URL=
LANGFUSE_ALERT_WEBHOOK_HEADERS={}

# =============================================================================
# 📊 LANGWATCH — بديل مراقبة الـ LLM
# =============================================================================
LANGWATCH_API_KEY=sk-lw-YOUR_LANGWATCH_KEY_HERE
LANGWATCH_PROJECT=AhmedETAP
LANGWATCH_ENDPOINT=https://app.langwatch.ai

# =============================================================================
# 🤖 LLM PROVIDER API KEYS — مفاتيح مزودي النماذج اللغوية
# =============================================================================
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here
MISTRAL_API_KEY=your-mistral-api-key-here
TOGETHER_API_KEY=your-together-api-key-here
COHERE_API_KEY=your-cohere-api-key-here
PERPLEXITY_API_KEY=your-perplexity-api-key-here
DEEPSEEK_API_KEY=your-deepseek-api-key-here
FIREWORKS_API_KEY=your-fireworks-api-key-here
MOONSHOT_API_KEY=your-moonshot-api-key-here
MINIMAX_API_KEY=your-minimax-api-key-here
QWEN_API_KEY=your-qwen-api-key-here
GLM_API_KEY=your-glm-api-key-here
NVIDIA_API_KEY=your-nvidia-api-key-here

# =============================================================================
# 🏗️ MASTRA RUNTIME CONFIGURATION — إعدادات محرك Mastra
# =============================================================================
MASTRA_PLATFORM_ACCESS_TOKEN=your-mastra-access-token-here
MASTRA_LOG_LEVEL=info

# =============================================================================
# ⚙️ ETAP INTEGRATION — تكامل ETAP المكتبي والمحاكي
# =============================================================================
USE_ETAP=false
PRIVACY_MODE=false
ETAP_LICENSE_PATH=
ETAP_HOST=localhost
ETAP_PORT=5000
ETAP_WORKER_URL=http://localhost:8081

# =============================================================================
# ☁️ CLOUDFLARE EDGE PROTECTION — حماية Cloudflare
# =============================================================================
CLOUDFLARE_ORIGIN_SECRET=your-origin-secret-here
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token-here

# =============================================================================
# ⚡ SUPABASE INTEGRATION — تكامل سوبابيس
# =============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_PAT=your-supabase-pat-here

# =============================================================================
# 🔄 CELERY & ASYNC WORKERS — عمال المهام غير المتزامنة
# =============================================================================
CELERY_BROKER_URL=redis://:your-strong-redis-password-here@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:your-strong-redis-password-here@localhost:6379/0
WORKER_CONCURRENCY=4

# =============================================================================
# 🐙 GITHUB & CI/CD — جيت هاب وخطوط الأنابيب
# =============================================================================
GITHUB_TOKEN=ghp_YOUR_GITHUB_PAT_HERE
GITHUB_REPO=your-org/your-repo-name
SONAR_TOKEN=your-sonar-cloud-token-here

# =============================================================================
# 📧 EMAIL & NOTIFICATIONS — البريد الإلكتروني والإشعارات
# =============================================================================
RESEND_API_KEY=re_YOUR_RESEND_KEY_HERE
ALERT_WEBHOOK_URL=

# =============================================================================
# 🏖️ DAYTONA & CODESANDBOX — بيئات التطوير السحابية
# =============================================================================
DAYTONA_API_KEY=dtn_YOUR_DAYTONA_KEY
DAYTONA_TARGET=local
CODESANDBOX_API_KEY=csb_YOUR_CSB_KEY
CODESANDBOX_ENABLED=false

# =============================================================================
# 🔑 OAUTH CLIENT — المصادقة الموحدة
# =============================================================================
OAUTH_CLIENT_ID=your-oauth-client-id-here
OAUTH_CLIENT_SECRET=your-oauth-client-secret-here
OAUTH_CLIENT_NAME=ahmed etap
OAUTH_REDIRECT_URI=http://localhost:8000/auth/oauth/callback
OAUTH_PROVIDER=generic
OAUTH_SCOPES=openid profile email

# =============================================================================
# ▲ VERCEL DEPLOYMENT — النشر على Vercel
# =============================================================================
VERCEL_PROJECT_ID=prj_YOUR_PROJECT_ID
VERCEL_ORG_ID=team_YOUR_ORG_ID
VERCEL_TOKEN=vcp_YOUR_ACCESS_TOKEN

# =============================================================================
# 🛰️ SMITHERY MCP & HUGGING FACE SPACE
# =============================================================================
SMITHERY_API_KEY=your-smithery-key-here
SMITHERY_BASE_URL=https://api.smithery.ai
HF_TOKEN=hf_YOUR_HF_TOKEN_HERE
HF_SPACE_NAME=your-username/AhmedETAP-Platform
HF_REPO_URL=https://huggingface.co/spaces/your-username/AhmedETAP-Platform

# =============================================================================
# 🔒 SECRETS MANAGER (HashiCorp Vault — optional)
# =============================================================================
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=your-vault-token-here

# =============================================================================
# 🔌 ACP RUNTIME (Agent Communication Protocol)
# =============================================================================
ACP_TRANSPORT=stdio    # stdio | unix | websocket
ACP_SOCKET_PATH=/tmp/acp.sock
ACP_LOG_LEVEL=INFO

# =============================================================================
# ⚠️ SECURITY NOTICE
# =============================================================================
# NEVER commit real secrets to Git. The .env file is gitignored.
# Rotate keys immediately if any leak occurs.
# =============================================================================
# END OF .env.example
# =============================================================================
