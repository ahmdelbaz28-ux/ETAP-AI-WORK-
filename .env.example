# =============================================================================
# AhmedETAP — Complete Canonical Environment Configuration
# =============================================================================
# نسخ هذا الملف إلى .env وأدخل قيمك الحقيقية
# Copy this file to .env and fill in your real values
# ⚠️ NEVER commit .env to version control
# =============================================================================

# =============================================================================
# 🌐 CORE ENVIRONMENT — بيئة التشغيل الأساسية
# =============================================================================
ENVIRONMENT=development        # development | staging | production
PORT=8000
HOST=0.0.0.0
APP_ENV=development

# =============================================================================
# 🔐 SECURITY & AUTHENTICATION — الأمان والمصادقة
# =============================================================================
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-jwt-secret-key-minimum-32-characters

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_ENCRYPTION_KEY=your-fernet-key-here
ENCRYPTION_KEY=your-encryption-key-here

# Required for session middleware (docker-compose.yml & web sessions)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=your-strong-session-secret-here

# =============================================================================
# 🗄️ DATABASE — قاعدة البيانات
# =============================================================================
# Local development SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./data/etap_platform.db

# Production PostgreSQL (canonical for production & docker-compose):
DATABASE_URL=postgresql+asyncpg://etap:your-strong-postgres-password-here@localhost:5432/etap_platform

# Dedicated Staging PostgreSQL (canonical for staging deployment & guards):
# STAGING_DATABASE_URL=postgresql+asyncpg://postgres.staging_ref:your-strong-staging-password@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# PostgreSQL credentials (REQUIRED for docker-compose)
POSTGRES_DB=etap_platform
POSTGRES_USER=etap
POSTGRES_PASSWORD=your-strong-postgres-password-here

# Legacy / Deploy Compose compatibility aliases
DB_NAME=etap_platform
DB_USER=etap
DB_PASSWORD=your-strong-postgres-password-here

# LibSQL (Mastra runtime storage)
MASTRA_DB_URL=file:./mastra.db

# =============================================================================
# ⚡ REDIS CACHE — التخزين المؤقت
# =============================================================================
REDIS_URL=redis://:your-strong-redis-password-here@localhost:6379/0

# For docker-compose: Redis password (REQUIRED by compose :?)
REDIS_PASSWORD=your-strong-redis-password-here

# Per-request tool call and token budget limits
MAX_LLM_CALLS_PER_REQUEST=15
MAX_TOKENS_PER_REQUEST=50000

# =============================================================================
# 🔌 ENGINEERING SERVICE — خدمة الحسابات الهندسية (FastAPI)
# =============================================================================
ENGINEERING_SERVICE_URL=http://localhost:8000
ENGINEERING_SERVICE_PORT=8000
ENGINEERING_SERVICE_HOST=0.0.0.0
ENGINEERING_SERVICE_API_KEY=your-service-api-key-here

# CORS Configuration (comma-separated, no spaces)
# ENGINEERING_SERVICE_CORS_ORIGINS is the primary env var; CORS_ALLOWED_ORIGINS is supported for compose
ENGINEERING_SERVICE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Set to 'true' ONLY in local development tests to bypass API key check (strictly blocked in production)
# ENGINEERING_SERVICE_AUTH_DISABLED=false

# Trusted proxy IPs for X-Forwarded-For header validation
ENGINEERING_SERVICE_TRUSTED_PROXIES=127.0.0.1

# =============================================================================
# 🧠 VECTOR & GRAPH DATABASES — قواعد بيانات المتجهات والرسوم البيانية
# =============================================================================
# Qdrant Vector DB (RAG & Semantic Search)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=your-strong-qdrant-api-key-here

# Neo4j Graph DB (Network Topology)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-strong-neo4j-password-here

# =============================================================================
# 📡 OBSERVABILITY & MONITORING — المراقبة والقياسات
# =============================================================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Grafana Admin Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your-strong-grafana-admin-password-here
# Legacy aliases
GRAFANA_USER=admin
GRAFANA_PASSWORD=your-strong-grafana-admin-password-here

# =============================================================================
# 📊 LANGFUSE — إدارة ومراقبة النماذج اللغوية (Langfuse LLM Observability)
# =============================================================================
# Dashboard: https://cloud.langfuse.com/
LANGFUSE_PUBLIC_KEY=pk-lf-YOUR_LANGFUSE_PUBLIC_KEY_HERE
LANGFUSE_SECRET_KEY=sk-lf-YOUR_LANGFUSE_SECRET_KEY_HERE
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_DEFAULT_MODEL=gpt-4o

# Safety-critical LLM guardrails
LLM_MAX_INPUT_CHARS=50000
LLM_ALLOW_UNKNOWN_MODELS=false
LLM_REQUIRE_AGENT_TAG=true
LLM_APPROVED_MODELS=gpt-4o,gpt-4o-mini,gpt-4-turbo,gpt-4.1,gpt-4.1-mini,claude-3-5-sonnet-20241022,claude-3-5-haiku-20241022,claude-3-opus-20240229,gemini-2.0-flash-exp,gemini-1.5-pro,meta/llama-3.1-8b-instruct,abacusai/dracarys-llama-3.1-70b-instruct,accounts/fireworks/models/kimi-k2p7-code,zai-org/GLM-5.1-FP8,mimo-v2.5,@cf/moonshotai/kimi-k2.6,minimaxai/minimax-m3,@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Optional webhook for safety alerts
LANGFUSE_ALERT_WEBHOOK_URL=
LANGFUSE_ALERT_WEBHOOK_HEADERS={}

# =============================================================================
# 📊 LANGWATCH — بديل مراقبة الـ LLM
# =============================================================================
LANGWATCH_API_KEY=sk-lw-YOUR_LANGWATCH_KEY_HERE
LANGWATCH_PROJECT=AhmedETAP
LANGWATCH_ENDPOINT=https://app.langwatch.ai

# =============================================================================
# 🤖 LLM PROVIDER API KEYS — مفاتيح مزودي النماذج اللغوية
# =============================================================================
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-4o
OPENAI_TIMEOUT=30
OPENAI_MAX_RETRIES=3

ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_VISION_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_TIMEOUT=30
ANTHROPIC_MAX_RETRIES=3

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_TIMEOUT=30
GEMINI_MAX_RETRIES=3

GROQ_API_KEY=your-groq-api-key-here
MISTRAL_API_KEY=your-mistral-api-key-here
TOGETHER_API_KEY=your-together-api-key-here
COHERE_API_KEY=your-cohere-api-key-here
PERPLEXITY_API_KEY=your-perplexity-api-key-here
DEEPSEEK_API_KEY=your-deepseek-api-key-here
FIREWORKS_API_KEY=your-fireworks-api-key-here
MOONSHOT_API_KEY=your-moonshot-api-key-here
MINIMAX_API_KEY=your-minimax-api-key-here
QWEN_API_KEY=your-qwen-api-key-here
GLM_API_KEY=your-glm-api-key-here
NVIDIA_API_KEY=your-nvidia-api-key-here

# =============================================================================
# 🏗️ MASTRA RUNTIME CONFIGURATION — إعدادات محرك Mastra
# =============================================================================
MASTRA_PLATFORM_ACCESS_TOKEN=your-mastra-access-token-here
MASTRA_LOG_LEVEL=info

# =============================================================================
# ⚙️ ETAP INTEGRATION — تكامل ETAP المكتبي والمحاكي
# =============================================================================
USE_ETAP=false
PRIVACY_MODE=false
ETAP_LICENSE_PATH=
ETAP_HOST=localhost
ETAP_PORT=5000
ETAP_WORKER_URL=http://localhost:8081
# DataHub etapAPI REST Auto-Build drawings (OFF by default; values only, never secrets)
# ETAP_REST_URL=https://<etap-host>/etapapi
# ETAP_REST_TOKEN=
# ETAP_DRAW_ENABLED=false
# ETAP_REST_ALLOWLIST=tenant-a,tenant-b

# =============================================================================
# ☁️ CLOUDFLARE EDGE PROTECTION — حماية Cloudflare
# =============================================================================
CLOUDFLARE_ORIGIN_SECRET=your-origin-secret-here
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token-here

# =============================================================================
# ⚡ SUPABASE INTEGRATION — تكامل سوبابيس
# =============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_PAT=your-supabase-pat-here

# =============================================================================
# 🔄 CELERY & ASYNC WORKERS — عمال المهام غير المتزامنة
# =============================================================================
CELERY_BROKER_URL=redis://:your-strong-redis-password-here@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:your-strong-redis-password-here@localhost:6379/0
WORKER_CONCURRENCY=4

# =============================================================================
# 🐙 GITHUB & CI/CD — جيت هاب وخطوط الأنابيب
# =============================================================================
GITHUB_TOKEN=ghp_YOUR_GITHUB_PAT_HERE
GITHUB_REPO=your-org/your-repo-name
SONAR_TOKEN=your-sonar-cloud-token-here

# =============================================================================
# 📧 EMAIL & NOTIFICATIONS — البريد الإلكتروني والإشعارات
# =============================================================================
RESEND_API_KEY=re_YOUR_RESEND_KEY_HERE
ALERT_WEBHOOK_URL=

# =============================================================================
# 🏖️ DAYTONA & CODESANDBOX — بيئات التطوير السحابية
# =============================================================================
DAYTONA_API_KEY=dtn_YOUR_DAYTONA_KEY
DAYTONA_TARGET=local
CODESANDBOX_API_KEY=csb_YOUR_CSB_KEY
CODESANDBOX_ENABLED=false

# =============================================================================
# 🔑 OAUTH CLIENT — المصادقة الموحدة
# =============================================================================
OAUTH_CLIENT_ID=your-oauth-client-id-here
OAUTH_CLIENT_SECRET=your-oauth-client-secret-here
OAUTH_CLIENT_NAME=ahmed etap
OAUTH_REDIRECT_URI=http://localhost:8000/auth/oauth/callback
OAUTH_PROVIDER=generic
OAUTH_SCOPES=openid profile email

# =============================================================================
# ▲ VERCEL DEPLOYMENT — النشر على Vercel
# =============================================================================
VERCEL_PROJECT_ID=prj_YOUR_PROJECT_ID
VERCEL_ORG_ID=team_YOUR_ORG_ID
VERCEL_TOKEN=vcp_YOUR_ACCESS_TOKEN

# =============================================================================
# 🛰️ SMITHERY MCP & HUGGING FACE SPACE
# =============================================================================
SMITHERY_API_KEY=your-smithery-key-here
SMITHERY_BASE_URL=https://api.smithery.ai
HF_TOKEN=hf_YOUR_HF_TOKEN_HERE
HF_SPACE_NAME=your-username/AhmedETAP-Platform
HF_REPO_URL=https://huggingface.co/spaces/your-username/AhmedETAP-Platform

# =============================================================================
# 🔒 SECRETS MANAGER (HashiCorp Vault — optional)
# =============================================================================
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=your-vault-token-here

# =============================================================================
# 🔌 ACP RUNTIME (Agent Communication Protocol)
# =============================================================================
ACP_TRANSPORT=stdio    # stdio | unix | websocket
ACP_SOCKET_PATH=/tmp/acp.sock
ACP_LOG_LEVEL=INFO

# =============================================================================
# 🗺️ ARCGIS ONLINE & ENTERPRISE PORTAL — تكامل نظم المعلومات الجغرافية
# =============================================================================
ARCGIS_PORTAL_URL=https://www.arcgis.com
ARCGIS_API_KEY=your-arcgis-api-key-here
ARCGIS_TOKEN=your-arcgis-token-here
FEATURE_FLAG_ARCGIS_PROVIDER=false
# Safe ArcGIS Online / Enterprise Write Operations (Dual-Control & Fail-Closed)
GIS_WRITE_ENABLED=false
GIS_SERVICE_ALLOWLIST=https://services.arcgis.com/your-org/arcgis/rest/services
GIS_MAX_FEATURES_PER_EDIT=100

# =============================================================================
# ⚡ ETAP AUTOMATION & REMOTE WORKER — أتمتة ETAP والعامل البعيد
# =============================================================================
USE_ETAP=false                       # true to enable ETAP worker integration
ETAP_WORKER_URL=http://localhost:8081
ETAP_WORKER_API_KEY=your-etap-worker-api-key-here
ETAP_WORKER_PORT=8081
ETAP_INSTALL_PATH=C:\Program Files\ETAP
ETAP_VERSION=19.0
WORKER_CPU_LIMIT=2.0
WORKER_MEMORY_LIMIT=4G

# =============================================================================
# 🚀 DEPLOYMENT TOPOLOGY & PRODUCTION FAIL-CLOSED CONTROLS
# =============================================================================
# single_replica (default for HF Spaces / standalone) | cluster | multi_replica | distributed
DEPLOYMENT_TOPOLOGY=single_replica
REPLICA_COUNT=1
ETAP_ENV=development

# Reject ephemeral SQLite database in production/staging environments.
# Setting to 'true' is strictly restricted to temporary test/demonstration runs.
ALLOW_SQLITE_IN_PROD=false

# =============================================================================
# 🛡️ EDGE PROTECTION & WEB APPLICATION FIREWALL (Akamai & Cloudflare)
# =============================================================================
# Akamai Origin Protection & Bot Scoring
AKAMAI_ORIGIN_SECRET=
AKAMAI_ORIGIN_RATE_LIMIT=100
AKAMAI_BOT_SCORE_BLOCK=30
AKAMAI_BOT_SCORE_CHALLENGE=50

# Cloudflare Origin & Geo Controls
CF_ORIGIN_RATE_LIMIT=100
CF_BLOCKED_COUNTRIES=

# Edge Security Headers & Proxies
ENFORCE_HTTPS=false
HSTS_MAX_AGE=31536000
X_FRAME_OPTIONS=SAMEORIGIN
TRUSTED_PROXY_HOPS=1
CRON_SECRET=

# Hugging Face Spaces & Extra CORS Origins
HF_API_KEY=
HF_SPACE_URL=https://your-space-name.hf.space
EXTRA_CORS_ORIGINS=
CSRF_SECRET=your-csrf-secret-key-minimum-32-characters
CSRF_ALLOWED_ORIGINS=

# =============================================================================
# ⏱️ RATE LIMITING & WEBHOOK ENGINE
# =============================================================================
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=120
RATE_LIMIT_PREFIX=rl:
USE_REDIS_RATE_LIMIT=false

# Webhook Inbound/Outbound Rate Limits & Timeouts
WEBHOOK_RATE_LIMIT_MAX=100
WEBHOOK_RATE_LIMIT_WINDOW=60
WEBHOOK_DNS_TIMEOUT=5
EMAIL_WEBHOOK_SECRET=your-outbound-webhook-signing-secret
RESEND_WEBHOOK_SECRET=your-inbound-resend-webhook-signing-secret

# =============================================================================
# 🗄️ DATABASE POOL & ADVANCED ENGINE CONFIGURATION
# =============================================================================
DB_CONNECT_TIMEOUT=10
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_MAX_CONNECTIONS=50
DB_ECHO=false

# =============================================================================
# ⚡ REDIS ADVANCED CONNECTION OPTIONS
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
CACHE_TTL=3600
TOKEN_BLACKLIST_PREFIX=bl:

# =============================================================================
# 🔐 AUTHENTICATION, TOKENS & SECURITY CONTROLS
# =============================================================================
SECRET_KEY=your-legacy-secret-key-here
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7
ALLOW_EPHEMERAL_JWT_IN_DEV=false
ALLOW_TEST_TOKENS=false
AUTH_RETURN_RESET_TOKEN=false
RESET_TOKEN_EXPIRE_MINUTES=15
MFA_CHALLENGE_EXPIRE_MINUTES=5
SESSION_TTL_SECONDS=86400
INITIAL_ADMIN_EMAIL=admin@etap.local
ALLOWED_APP_URL_DOMAINS=localhost,127.0.0.1
API_KEY_ENCRYPTION_KEY=

# Login & OTP Brute-Force Rate Limiting
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SEC=300
LOGIN_IP_RATE_LIMIT_MAX=10
LOGIN_IP_RATE_LIMIT_WINDOW_SEC=300
FORGOT_PASSWORD_RATE_LIMIT_MAX=3
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_SEC=300
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_ISSUE_COOLDOWN_SEC=60
OTP_ISSUE_COOLDOWN_AFTER_FAILS=300
MAGIC_LINK_TTL_SECONDS=900
MAGIC_LINK_RATE_LIMIT_MAX=3
MAGIC_LINK_RATE_LIMIT_WINDOW=300

# =============================================================================
# 📈 SENTRY & SIEM / SYSLOG LOGGING
# =============================================================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=2.1.0
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

SIEM_ENABLED=false
SIEM_HOST=
SIEM_PORT=514
SIEM_PROTOCOL=UDP
SIEM_FACILITY=LOG_LOCAL0
SIEM_SEVERITY=LOG_INFO
SIEM_APP_NAME=AhmedETAP
SIEM_LOG_FILE=
SIEM_TLS_CA_CERT=

# =============================================================================
# 🔭 OPENTELEMETRY (OTel) TRACING
# =============================================================================
OTEL_SERVICE_NAME=AhmedETAP
OTEL_SERVICE_VERSION=2.1.0
OTEL_ENVIRONMENT=development
OTEL_EXPORTER_TYPE=none
OTEL_EXPORTER_ENDPOINT=

# =============================================================================
# 📧 EMAIL & RESEND SERVICE EXTENDED CONFIGURATION
# =============================================================================
RESEND_ENABLED=true
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=AhmedETAP
RESEND_REPLY_TO=support@etap.local
RESEND_TIMEOUT_SECONDS=10
RESEND_MAX_RETRIES=3
RESEND_RATE_LIMIT_MAX=100
RESEND_RATE_LIMIT_WINDOW=60
RESEND_WELCOME_EMAIL_ENABLED=true
RESEND_LOGIN_ALERTS_ENABLED=true
RESEND_LOCKOUT_ALERTS_ENABLED=true
RESEND_NOTIFICATION_EMAILS_ENABLED=true
EMAIL_APP_URL=http://localhost:3000
EMAIL_SUPPORT_ADDRESS=support@etap.local
EMAIL_BRAND_NAME=AhmedETAP
EMAIL_BRAND_TAGLINE=Autonomous Power Systems Intelligence
EMAIL_LOG_BUFFER_MAX=1000
EMAIL_DIGEST_ENABLED=false
EMAIL_DIGEST_SCHEDULE_DAILY=0 8 * * *
EMAIL_DIGEST_SCHEDULE_WEEKLY=0 8 * * 1
EMAIL_DIGEST_TIMEZONE=UTC
EMAIL_DASHBOARD_DEV_OPEN=false
EMAIL_DASHBOARD_ADMIN_ROLES=admin,superadmin

